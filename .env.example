# Bu dosyayi ".env" olarak kopyala. .env GIT'E GIRMEZ (.gitignore).
#
# Tek zorunlu deger APP_JWT_SECRET. Geri kalani varsayilanlariyla calisir -
# yigin kendi Postgres'ini ve kendi odyssey-auth'unu ayaga kaldiriyor,
# baska bir projeye bagimli degil.

# Token imza anahtari. odyssey-auth ve mailer-backend AYNI degeri kullanir:
# token'i odyssey-auth uretir, backend ayni sirla dogrular. Farkli olursa
# her istek 401 doner ve sebebi logda gorunmez.
# En az 32 karakter (256 bit). Yerelde rastgele bir dize yeterli.
APP_JWT_SECRET=

# --- Veritabani (yiginin kendi Postgres'i) ---
DB_NAME=aksa_mailer
DB_USERNAME=aksa_mailer
DB_PASSWORD=aksa_mailer

# --- Yayinlanan portlar ---
# Capacity Planner'in Odyssey yigini da 4173 ve 8081 kullanir; ikisi ayni
# anda calisamaz. Ikisini birden ayakta tutmak istersen buradan degistir.
ODYSSEY_SHELL_PORT=4173
ODYSSEY_AUTH_PORT=8081
BACKEND_PORT=8082
FRONTEND_PORT=5174
# Postgres'i disariya acan port. 5432'de baska bir Postgres varsa cakismasin
# diye 5433. Konteynerler arasi iletisim her zaman 5432 uzerinden.
DB_PORT_YAYIN=5433
